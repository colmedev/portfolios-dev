---
import { Icon } from 'astro-icon/components'
import Badges from './Badges.astro'
import Burgerbutton from './Burgerbutton.astro'
import Button from './Button.astro'
import Moreinfo from './Moreinfo.astro'
---

<div class="hero-container">
  <div class="gradient"></div>
  <div class="hero">
    <Badges variant="primary" text="Disponible para trabajar" />

    <h1>Hola soy Jaime Gutiérrez</h1>

    <p>
      Ingeniero de software con 5+ años de experiencia, <span
        >especializado en React y Node.js.</span
      >
    </p>
    <p>Innovando y creando soluciones efectivas desde Uruguay</p>

    <Button
      variant="primary"
      text="Descargar CV"
      href="Aqui colocar el link de descarga del CV"
    />

    <Button text="LinkedIn" href="#" variant="secondary">
      <Icon name="linkedin" slot={'icon'} />
    </Button>

    <div class="more-info">
      <Moreinfo href="#experience" />
    </div>
    <div class="social-media">
      <Burgerbutton />
    </div>
  </div>
</div>

<style>
  .hero-container {
    position: relative;
    overflow: hidden;
    background-color: #000000;

    & .hero {
      position: relative;
      z-index: 2;
      padding: 5rem;

      @media (width < 768px) {
        padding-block: 3rem;
        padding-inline: 0.5rem;
      }

      & .more-info {
        padding-block-start: 5rem;
      }

      & .social-media {
        display: flex;
        justify-content: end;
        padding-block-start: 3rem;
        padding-inline-end: 5rem;

        @media (width < 768px) {
          padding-block: 5rem;
        }
      }
    }

    & .gradient {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 650px;
      height: 650px;
      border-radius: 100%;
      background-image: linear-gradient(#1100ff 10%, #ff00f2);
      filter: blur(250px);
      transition: all 450ms ease-out;
      position: absolute;
      pointer-events: none;
      left: 0;
      top: 0;
      transform: translate(calc(-50% + 15px), -50%);
      z-index: 1;
    }
  }
</style>

<script>
  const gradient = document.querySelector<HTMLElement>('.gradient')

  document.addEventListener('mousemove', function (e) {
    const x = e.clientX
    const y = e.clientY
    gradient.style.transform = `translate3d(calc(${x}px - 50%), calc(${y}px - 50%), 0)`
  })
</script>
