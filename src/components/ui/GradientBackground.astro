<div class="gradient-background">
  <slot />
</div>

<style>
  ::root {
    --gradient: radial-gradient(
      48.42% 48.42% at 49.41% 51.58%,
      #353869 0%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  .gradient-background {
    position: absolute;
    top: -3%;
    left: 50%;
    max-height: 1064px;
    max-width: 1064px;
    height: 100%;
    width: 100%;
    background: var(--gradient);
    transform: translate(-50%, -50%);
    z-index: -1;
  }

  @media (max-width: 480px) {
    .gradient-background {
      max-height: 514px;
      max-width: 514px;
      height: 100%;
      width: 100%;
    }
  }
</style>
