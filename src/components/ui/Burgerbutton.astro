---
import { Icon } from 'astro-icon/components'
---

<div class="circle-menu">
  <div class="menu circle">
    <div class="icon">
      <Icon name="burger" size={24} />
    </div>
  </div>

  <span class="circle">
    <Icon name="twitter" size={24} />
  </span>

  <span class="circle">
    <Icon name="facebook" size={24} />
  </span>

  <span class="circle">
    <Icon name="instagram" size={24} />
  </span>

  <span class="circle">
    <Icon name="mail" size={24} />
  </span>

  <span class="circle">
    <Icon name="linkedin" size={24} />
  </span>

  <span class="circle">
    <Icon name="github" size={24} />
  </span>
</div>
<style>
  :root {
    --body-color: #010c15;

    --menu-size: 50px;
    --menu-icon-size: calc(var(--menu-size) / 2);
    --menu-color-bg: #26d0ce;
    --menu-color-fg: var(--body-color);

    --item-size: calc(var(--menu-size) * 0.9);
    --item-color-bg: #267dd0;
    --item-color-fg: #fff;
    --item-distance: calc(var(--item-size) * 1.5);
    --item-timing: ease-in-out;

    color-scheme: dark;
  }

  .circle-menu {
    position: relative;
    display: grid;
    place-items: center;

    .circle {
      border-radius: 50%;
      box-shadow: 0 6px 50px 0 rgb(255 255 255 / 0.2);
    }

    .menu {
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      width: var(--menu-size);
      height: var(--menu-size);
      color: var(--menu-color-fg);
      background: var(--menu-color-bg);
      transition:
        scale 0.5s,
        background 0.3s;
      position: absolute;
      z-index: 1;

      &:hover {
        background: #26d079;
        color: #fff;
      }

      & .icon {
        display: flex;
        align-items: center;
        width: var(--menu-icon-size);
        height: var(--menu-icon-size);

        & span {
          width: 100%;
          height: 5px;
          background: currentcolor;
          transition:
            transform 0.3s,
            color 0.3s;

          &:nth-child(1),
          &:nth-child(3) {
            transform-origin: 0% 50%;
          }

          &:nth-child(2) {
            transform-origin: 50% 50%;
          }
        }
      }
    }

    & > span {
      --angle: calc((var(--item) / var(--max-items)) * (2 * 3.14));
      --x: calc(cos(var(--angle)) * var(--item-distance));
      --y: calc(sin(var(--angle)) * var(--item-distance));
      --delay: calc(var(--item) * 0.1s);

      cursor: pointer;
      position: absolute;
      pointer-events: none;
      width: var(--item-size);
      height: var(--item-size);
      color: var(--item-color-fg);
      background: var(--item-color-bg);
      transform: scale(0) translate(0, 0);
      transition:
        transform 0.3s var(--item-timing) var(--delay),
        background 0.3s;
      display: flex;
      align-items: center;
      justify-content: center;

      & svg {
        position: relative;
        transform: translate(-1%, 3%);
        width: calc(var(--item-size) / 2.25);
        height: calc(var(--item-size) / 2.25);
      }

      &:hover {
        background: #d07926;
      }
    }

    &.open {
      & .menu {
        scale: 0.6;

        & span {
          &:nth-child(1) {
            transform: translateX(22%) rotate(45deg) translateX(-11%);
          }

          &:nth-child(2) {
            transform: scale(0, 1);
          }

          &:nth-child(3) {
            transform: translateX(22%) rotate(-45deg) translateX(-11%);
          }
        }
      }

      & > span {
        pointer-events: all;
        transform: scale(1) translate(var(--x), var(--y));
      }
    }
  }
</style>

<script>
  const menu = document.querySelector('.circle-menu')
  const items = menu?.querySelectorAll('& > span')

  menu.style.setProperty('--max-items', items.length)

  document.querySelector('.menu').addEventListener('click', () => {
    menu.classList.toggle('open')
  })

  items.forEach((el, index) => {
    el.style.setProperty('--item', index)
  })
</script>
