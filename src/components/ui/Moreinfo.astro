---
interface Props {
  href: string
}

const href = Astro.props.href
---

<a href={href} aria-label="Ver más información">
  <div class="circle-container">
    <svg
      id="rotatingTextSvg"
      width="80"
      height="80"
      viewBox="0 0 150 150"
      overflow="visible"
      xmlns="http://www.w3.org/2000/svg"
    >
      <circle cx="75" cy="75" r="70" fill="#2C2C2C"></circle>
      <path
        id="circlePath"
        d="M75 5 a70,70 0 1,1-70,70 70,70 0 1,1 70,-70"
        fill="transparent"></path>
      <path
        id="circlePath2"
        d="M75 145 a70,70 0 1,1 70,-70 70,70 0 1,1 -70,70"
        fill="transparent"></path>
      <g id="textGroup">
        <text>
          <textPath xlink:href="#circlePath" startOffset="0%">
            Ver más información
          </textPath>
          <textPath xlink:href="#circlePath2" startOffset="0%">
            Ver más información
          </textPath>
        </text>
      </g>
      <svg
        x="52"
        y="49"
        width="50"
        height="60"
        viewBox="0 0 33 40"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M1.22406 21.6411C1.37583 21.4944 1.55502 21.379 1.7514 21.3016C1.94778 21.2242 2.15749 21.1862 2.36855 21.1899C2.5796 21.1936 2.78787 21.2388 2.98142 21.3231C3.17498 21.4073 3.35004 21.5288 3.49659 21.6808L15.004 33.5991L15.5531 2.14319C15.5605 1.71725 15.7369 1.3117 16.0433 1.01577C16.3498 0.719842 16.7612 0.557771 17.1872 0.565205C17.6131 0.57264 18.0186 0.748973 18.3146 1.05542C18.6105 1.36186 18.7726 1.77331 18.7651 2.19926L18.2161 33.6552L30.1325 22.1457C30.4391 21.8496 30.8507 21.6874 31.2769 21.6949C31.7031 21.7023 32.1089 21.8788 32.405 22.1854C32.7011 22.492 32.8632 22.9037 32.8558 23.3299C32.8484 23.756 32.6719 24.1618 32.3653 24.4579L17.6588 38.6598C17.5071 38.8065 17.3279 38.9219 17.1315 38.9993C16.9351 39.0767 16.7254 39.1147 16.5143 39.111C16.3033 39.1073 16.095 39.062 15.9015 38.9778C15.7079 38.8936 15.5328 38.772 15.3863 38.6201L1.1844 23.9136C1.03768 23.7619 0.922311 23.5827 0.844891 23.3863C0.767473 23.1899 0.729524 22.9802 0.733208 22.7691C0.736892 22.5581 0.782137 22.3498 0.866361 22.1563C0.950587 21.9627 1.07214 21.7877 1.22406 21.6411Z"
          fill="white"></path>
      </svg>
    </svg>
  </div>
</a>

<style>
  a {
    display: block;
    width: 95px;
  }
  .circle-container {
    width: 80px;
    height: 83px;
    padding: 46px;
    background-color: #2c2c2c;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  @keyframes rotateText {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  #rotatingTextSvg {
    transform-origin: 50% 50%;
  }

  #rotatingTextSvg #textGroup {
    transform-origin: 50% 50%;
    animation: rotateText 10s linear infinite;
  }

  #rotatingTextSvg text {
    font-size: 16px;
    fill: white;
  }

  #rotatingTextSvg .static {
    transform-origin: 75px 75px;
  }
</style>
